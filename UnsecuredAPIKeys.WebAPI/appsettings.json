{
  "SearchCredentials": {
    "ProtectedStorageEnabled": false,
    "EnvironmentBootstrapEnabled": false,
    "LegacyUnownedGrantScope": null,
    "Protection": {
      "ActiveKeyVersion": 0,
      "Keys": {}
    },
    "Fingerprint": {
      "ActiveKeyVersion": 0,
      "Keys": {}
    },
    "Migration": {
      "PreScrubGuardEnabled": false,
      "LegacyPlaintextReadEnabled": false,
      "LegacyPlaintextWriteEnabled": false,
      "VerifyProtectedReadsOnStartup": false
    }
  },
  "CredentialScheduler": {
    "Enabled": false,
    "MasterScraperClaimsEnabled": false,
    "WorkerClaimsEnabled": false,
    "LegacyTokenSyncEnabled": false,
    "AllowWorkerLocalFallback": false
  },
  "SearchProviders": {
    "InstancesEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
